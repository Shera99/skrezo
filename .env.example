# ── Приложение ─────────────────────────────────────────────────────────────
APP_ENV=local                 # local | staging | production
APP_DEBUG=true
API_V1_PREFIX=/api/v1
# Префикс за обратным прокси (например /skrz). Пусто — сервис на своём домене.
ROOT_PATH=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Для нативного запуска — localhost; в docker-compose переопределяется на host=postgres.
# Порт 5433 — контейнер Postgres проброшен сюда (5432 занят локальным Postgres на хосте).
DATABASE_URL=postgresql+asyncpg://skrezo:skrezo@localhost:5434/skrezo

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── JWT (единый контур — один секрет для всех) ─────────────────────────────
# ≥32 байт. Для prod сгенерировать: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-jwt-secret-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900          # 15 минут
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 дней

# ── Rate-limit (защита от перебора; счётчики в Redis, фиксированное окно) ───
LOGIN_RATE_LIMIT=10                   # попыток входа на пару IP+телефон…
LOGIN_RATE_WINDOW_SEC=60              # …за окно
LEAD_RATE_LIMIT=5                     # заявок с одного IP…
LEAD_RATE_WINDOW_SEC=3600             # …за час
CHANGE_PASSWORD_RATE_LIMIT=10
CHANGE_PASSWORD_RATE_WINDOW_SEC=60
OTP_REQUEST_RATE_LIMIT=5              # запросов кода на пару IP+телефон…
OTP_REQUEST_RATE_WINDOW_SEC=300       # …за 5 минут

# ── OTP-код (вход по телефону) ─────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300                   # срок жизни кода
OTP_MAX_ATTEMPTS=5                    # неверных попыток до блокировки кода
OTP_REGISTRATION_TTL_SECONDS=900      # срок жизни registrationToken после verify
# true — код возвращается в ответе ручки (ТОЛЬКО dev/тесты, в бою всегда false)
OTP_EXPOSE_CODE=false

# ── Доставка OTP-кода ──────────────────────────────────────────────────────
# Каналы В ПОРЯДКЕ ПРИОРИТЕТА: сначала бесплатный Telegram, при неудаче
# WhatsApp, и только потом платная SMS. Пусто — код уходит в лог (только dev!).
# ВНИМАНИЕ: значение НЕ комментировать в той же строке — «KEY=  # текст» будет
# прочитано как значение «# текст».
OTP_CHANNELS=
OTP_DELIVERY_TIMEOUT_SECONDS=5
# Telegram Gateway (gatewayapi.telegram.org): показывает код своим шаблоном
TELEGRAM_GATEWAY_URL=https://gatewayapi.telegram.org
TELEGRAM_GATEWAY_TOKEN=
# WhatsApp-бот: номер уходит без ведущего «+»
WHATSAPP_API_URL=
WHATSAPP_ACCOUNT_ID=
# SMSPRO (nikita.kg): XML-протокол, sender согласуется с оператором
SMSPRO_URL=https://smspro.nikita.kg/api/message
SMSPRO_LOGIN=
SMSPRO_PASSWORD=
SMSPRO_SENDER=

# ── Уведомления пользователям (данные для входа) ───────────────────────────
# Те же провайдеры, что у OTP, но с произвольным текстом — поэтому Telegram
# Gateway сюда не годится (он умеет только коды своим шаблоном). Порядок тот же
# смысл: сначала бесплатный WhatsApp, платная SMS запасным. Пусто — сообщение
# уходит в лог (только dev: в тексте бывает временный пароль!).
NOTIFY_CHANNELS=
NOTIFY_DELIVERY_TIMEOUT_SECONDS=5

# ── Нотификации команды Skrezo ─────────────────────────────────────────────
# Уведомления команды о новых лидах (групповой чат):
TELEGRAM_TEAM_BOT_TOKEN=
TELEGRAM_TEAM_CHAT_ID=

# ── Пуш-уведомления в приложение клиники (FCM + APNs) ──────────────────────
# Рубильник живых пушей: false — всё уходит в лог даже с заполненными кредами.
PUSH_ENABLED=false
# FCM HTTP v1: service-account Firebase — JSON строкой ЛИБО путь к файлу.
FCM_SERVICE_ACCOUNT_JSON=
# APNs token-based: содержимое .p8 (\n вместо переводов строки) ЛИБО путь к файлу.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# true — sandbox APNs (dev-сборки приложения); false — прод.
APNS_USE_SANDBOX=true

# ── WhatsApp Cloud API (переписка с пациентами; НЕ OTP-каналы выше!) ───────
# Пустой токен = лог-фолбэк: входящие сохраняются, исходящие пишутся в лог.
WA_CLOUD_API_URL=https://graph.facebook.com/v23.0
WA_CLOUD_ACCESS_TOKEN=
# APP_SECRET приложения Meta — подпись вебхука X-Hub-Signature-256.
# Пусто — подпись не проверяется (ТОЛЬКО dev, в бою обязателен).
WA_CLOUD_APP_SECRET=
# Проверочный токен подписки вебхука (GET /whatsapp/webhook) — придумайте свой.
WA_CLOUD_VERIFY_TOKEN=

# ── AI-ассистент (Ф2) ──────────────────────────────────────────────────────
# off — ассистент выключен (диалоги копятся, отвечает человек); gemini — вкл.
AI_PROVIDER=off
# Ключ Google AI Studio (aistudio.google.com/apikey).
# ⚠️ Бесплатный тир может использовать содержимое запросов для улучшения
# продуктов Google — до реальных пациентов включить платный тир.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Мысли модели выключены: фактическим ответам они не нужны, а токены жгут
GEMINI_THINKING_LEVEL=minimal
AI_TEMPERATURE=0.2                    # фактические ответы — низкая температура
AI_MAX_TOKENS=1024
AI_MAX_TOOL_CALLS=6                   # потолок инструментов на один ход
AI_RATE_LIMIT_PER_HOUR=30             # сообщений в час от одного пациента (§14)

# Распознавание голосовых (§11). Пусто — выключено: голосовые сохраняются и
# уходят администратору. "gemini" — расшифровка тем же ключом, что и ассистент
SPEECH_PROVIDER=
SPEECH_MODEL=gemini-3.6-flash
SPEECH_MIN_CONFIDENCE=0.7             # ниже порога — зовём человека, не гадаем

# ── Хранилище файлов ───────────────────────────────────────────────────────
# Каталог на диске: storage/{images|files}/ГГГГ/ММ/ДД/. В докере смонтирован
# как ./storage — иначе снимки исчезнут при пересоздании контейнера.
STORAGE_ROOT=storage
UPLOAD_MAX_BYTES=20971520

# ── Фоновые задачи (arq-воркер) ────────────────────────────────────────────
# За сколько дней предупредить владельца о конце пробного периода.
TRIAL_WARNING_DAYS=3
# Сколько хранить журнал запусков джоб (job_run): он растёт с каждым сообщением.
JOB_RUN_RETENTION_DAYS=30

# ── Биллинг / подписка ─────────────────────────────────────────────────────
TRIAL_DAYS=30
CARD_ATTACH_DEADLINE_DAYS=7
DEFAULT_LANG=ru
