# Skrezo worker — arq: очередь заданий (ответы ассистента, вебхуки WhatsApp, пуши)
# и cron'ы (подписки, напоминания, сводки). Инстансы skrezo-worker@1, @2: cron'ы
# ставятся по job_id в общем Redis (выполняет один), диспетчер берёт события SKIP LOCKED.
[Unit]
Description=Skrezo worker (arq) #%i
PartOf=skrezo.target
After=network-online.target postgresql.service pgbouncer.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=skrezo
Group=skrezo
WorkingDirectory=/opt/skrezo/app
# Без PYTHONDONTWRITEBYTECODE: uv не компилирует .pyc, и с запретом кэша каждый старт
# заново компилировал все библиотеки — ~13 с CPU и ~15 с до готовности процесса.
Environment=PYTHONUNBUFFERED=1 TZ=UTC
ExecStart=/opt/skrezo/app/.venv/bin/arq app.jobs.worker.WorkerSettings
Restart=always
RestartSec=5
# arq по SIGTERM не ждёт текущие задания: отменяет их и возвращает в очередь
# («cancelled, will be run again») — доделает другой воркер или этот после старта;
# повтор безопасен (дедуп вебхуков, координатор ответа ассистента). 120 с — запас
# на закрытие соединений, обычно остановка занимает секунды.
TimeoutStopSec=120
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=skrezo.target
