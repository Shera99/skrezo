# Настройки wa-service (WhatsApp-шлюз). На сервере: /etc/skrezo-wa/wa.env,
# владелец root:skrezo-wa, права 640 — см. docs/DEPLOY.md, раздел 13.
# Файл читает systemd (EnvironmentFile): комментарий только отдельной строкой.

# Своя база skrezo_wa, напрямую в Postgres (не через PgBouncer: его пулер
# настроен только на базу skrezo). connection_limit — пул Prisma; по умолчанию
# он равен 2×CPU+1, на 12 ядрах это 25 соединений на пустом месте.
DATABASE_URL=postgresql://skrezo_wa:ЗАМЕНИТЬ_ПАРОЛЬ@127.0.0.1:5432/skrezo_wa?connection_limit=5
DIRECT_URL=postgresql://skrezo_wa:ЗАМЕНИТЬ_ПАРОЛЬ@127.0.0.1:5432/skrezo_wa?connection_limit=5

# Тот же порт — в WHATSAPP_API_URL у Skrezo.
API_PORT=5001
